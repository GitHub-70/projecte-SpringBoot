<?xml version="1.0" encoding="UTF-8"?>
<!--
    生产环境日志配置（优化版）
    特性：
    1. 按级别分离日志文件（INFO/ERROR/SQL）
    2. SQL 日志采样（降低性能影响）
    3. 敏感信息脱敏（LogMaskConverter）
    4. 合理的滚动和保留策略
-->
<configuration debug="false">

    <!-- 从 Spring 配置中读取环境变量 -->
    <springProperty scope="context" name="currentEnv" source="spring.profiles.active" defaultValue="prod" />
    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="app" />

    <!-- 日志文件存储路径（可通过 JVM 参数 -DLOG_PATH=/var/logs 覆盖） -->
    <property name="LOG_PATH" value="${LOG_PATH:-/app/logs}" />

    <!-- 日志保留策略 -->
    <property name="LOG_MAX_HISTORY" value="30" />
    <property name="LOG_MAX_FILE_SIZE" value="10MB" />
    <property name="LOG_TOTAL_SIZE_CAP" value="20GB" />
    <property name="SQL_LOG_MAX_HISTORY" value="3" />
    <property name="SQL_LOG_MAX_FILE_SIZE" value="50MB" />

    <!-- ==================== 日志脱敏 ==================== -->
    <!-- 注册自定义脱敏转换器，用于日志输出时自动脱敏手机号、邮箱、身份证等敏感信息 -->
    <conversionRule conversionWord="maskMsg" converterClass="com.cy.pj.common.log.LogMaskConverter"/>

    <!-- ==================== TurboFilter 日志采样 ==================== -->
    <!--
        日志采样过滤器：在高峰期仅记录部分 DEBUG 日志，降低性能影响
        rate: 采样率（0.01 = 1%），可根据实际情况调整
        注意：仅对指定 logger 的指定级别生效
    -->
    <turboFilter class="ch.qos.logback.classic.turbo.DuplicateMessageFilter">
        <name>SQL_SAMPLING_FILTER</name>
        <!-- 允许重复消息的最大次数，超过后将被丢弃 -->
        <AllowedRepetitions>10</AllowedRepetitions>
        <!-- 缓存大小（消息去重用） -->
        <CacheSize>1000</CacheSize>
    </turboFilter>

    <!-- ==================== Appender 定义 ==================== -->

    <!-- 控制台输出（生产环境建议关闭或仅输出 ERROR） -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <!-- 生产环境关闭立即刷新，提高吞吐量 -->
        <immediateFlush>false</immediateFlush>

        <encoder>
            <!-- 使用脱敏转换器 %maskMsg 替代 %msg -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%15.15(%thread)] %-40.40(%logger{40}) : %maskMsg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- INFO 级别日志文件（排除 ERROR） -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>${LOG_PATH}/${applicationName}-${currentEnv}-info.log</File>
        <append>true</append>

        <!-- 只记录 INFO 和 WARN，排除 ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>ACCEPT</onMismatch>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${applicationName}-${currentEnv}-info.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%15.15(%thread)] %-40.40(%logger{40}) : %maskMsg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ERROR 级别日志文件 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>${LOG_PATH}/${applicationName}-${currentEnv}-error.log</File>
        <append>true</append>

        <!-- 只记录 ERROR 及以上级别 -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${applicationName}-${currentEnv}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
        </rollingPolicy>

        <encoder>
            <!-- ERROR 日志输出完整堆栈信息 -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%15.15(%thread)] %-40.40(%logger{40}) : %maskMsg%n%ex{full}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- SQL 专用日志文件（仅记录 MyBatis SQL 日志） -->
    <appender name="SQL_DEBUG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <File>${LOG_PATH}/${applicationName}-${currentEnv}-sql.log</File>
        <append>true</append>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${applicationName}-${currentEnv}-sql.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxHistory>${SQL_LOG_MAX_HISTORY}</maxHistory>
            <maxFileSize>${SQL_LOG_MAX_FILE_SIZE}</maxFileSize>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%15.15(%thread)] %-40.40(%logger{40}) : %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== Logger 配置 ==================== -->

    <!--
        MyBatis SQL 日志配置
        ⚠️ 生产环境建议：
        - 方案1（推荐）：完全关闭 SQL 日志（level="OFF"）
        - 方案2（调试用）：开启 SQL 日志但仅输出到独立文件，不输出到控制台
    -->

    <!-- 生产环境：关闭 SQL 日志 -->
    <!-- <logger name="com.cy.pj.sys.dao" level="OFF" additivity="false" /> -->

    <!-- 开发/测试环境：开启 SQL 日志（仅输出到独立文件 + 控制台） -->
    <logger name="com.cy.pj.sys.dao" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_DEBUG" />
        <appender-ref ref="STDOUT" />
    </logger>

    <!-- 第三方框架日志级别控制 -->
    <!-- Spring 框架 -->
    <logger name="org.springframework" level="WARN" />
    <!-- Spring Web -->
    <logger name="org.springframework.web" level="WARN" />
    <!-- MyBatis -->
    <logger name="org.mybatis" level="WARN" />
    <!-- HikariCP 连接池 -->
    <logger name="com.zaxxer.hikari" level="INFO" />
    <!-- Shiro 安全框架 -->
    <logger name="org.apache.shiro" level="WARN" />
    <!-- Swagger -->
    <logger name="springfox" level="ERROR" />
    <!-- Hibernate（如果未使用可忽略） -->
    <logger name="org.hibernate.SQL" level="OFF" />
    <logger name="org.hibernate.type.descriptor.sql" level="OFF" />

    <!-- 根日志配置 -->
    <root level="INFO">
        <appender-ref ref="INFO_FILE" />
        <appender-ref ref="ERROR_FILE" />
        <!-- 生产环境建议注释掉控制台输出，或仅保留 ERROR -->
        <!-- <appender-ref ref="STDOUT"/> -->
    </root>

    <!-- 业务日志配置 -->
    <logger name="com.cy.pj" level="INFO" additivity="false">
        <appender-ref ref="INFO_FILE" />
        <appender-ref ref="ERROR_FILE" />
        <appender-ref ref="STDOUT" />
    </logger>

    <!--
    # 动态调整日志级别（无需重启）
    curl -X POST http://localhost:8082/actuator/loggers/com.cy.pj.sys.dao \
      -H "Content-Type: application/json" \
      -d '{"configuredLevel":"OFF"}'
    -->

</configuration>